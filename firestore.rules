rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Strict authentication and @diu.edu.bd university domain verification
    function isDiuUser() {
      return request.auth != null &&
             request.auth.token.email_verified == true &&
             request.auth.token.email.matches('^[a-zA-Z0-9._%+-]+@diu[.]edu[.]bd$');
    }
    
    function isOwner(userId) {
      return isDiuUser() && request.auth.uid == userId;
    }

    function isGroupHost(groupId) {
      return isDiuUser() && 
        get(/databases/$(database)/documents/groups/$(groupId)).data.host_id == request.auth.uid;
    }

    function userHasNoGroup(userId) {
      return get(/databases/$(database)/documents/users/$(userId)).data.current_group_id == null;
    }

    // 1. USERS COLLECTION (Permanent Profiles - Never deleted by 4-month expiration)
    match /users/{userId} {
      allow read: if isDiuUser();
      // On create: must be verified DIU user matching UID and email
      allow create: if isOwner(userId) && request.resource.data.email == request.auth.token.email;
      // On update: username and email are immutable (cannot be altered)
      allow update: if isOwner(userId) && 
                       request.resource.data.email == resource.data.email &&
                       request.resource.data.username == resource.data.username;
      allow delete: if false; // Permanent identity preservation
    }

    // 2. GROUPS COLLECTION
    match /groups/{groupId} {
      allow read: if isDiuUser();
      // Only verified DIU users who do NOT have an active group can create a new group
      allow create: if isDiuUser() && 
                       request.resource.data.host_id == request.auth.uid &&
                       userHasNoGroup(request.auth.uid);
      // Strictly only the CR can update group details or delete the group
      allow update, delete: if isGroupHost(groupId);
    }

    // 3. GROUP MEMBERS COLLECTION
    match /groupMembers/{memberId} {
      allow read: if isDiuUser();
      allow create: if isDiuUser() && (
        (request.resource.data.user_id == request.auth.uid && userHasNoGroup(request.auth.uid)) ||
        isGroupHost(request.resource.data.group_id)
      );
      allow update, delete: if isDiuUser() && (
        request.auth.uid == resource.data.user_id || 
        isGroupHost(resource.data.group_id)
      );
    }

    // 4. JOIN REQUESTS COLLECTION
    match /joinRequests/{requestId} {
      allow read: if isDiuUser() && (
        resource.data.user_id == request.auth.uid || 
        isGroupHost(resource.data.group_id)
      );
      allow create: if isDiuUser() && 
                       request.resource.data.user_id == request.auth.uid && 
                       userHasNoGroup(request.auth.uid);
      allow update: if isGroupHost(resource.data.group_id);
      allow delete: if isDiuUser() && (
        request.auth.uid == resource.data.user_id || 
        isGroupHost(resource.data.group_id)
      );
    }

    // 5. COURSES COLLECTION
    match /courses/{courseId} {
      allow read: if isDiuUser();
      allow create, update, delete: if isGroupHost(request.resource.data.group_id || resource.data.group_id);
    }

    // 6. ACADEMIC UPDATES COLLECTION (Quiz, Lab, Presentation, Assignment)
    match /updates/{updateId} {
      allow read: if isDiuUser();
      // Strictly only the CR can post, edit, or delete updates
      allow create, update, delete: if isGroupHost(request.resource.data.group_id || resource.data.group_id);
    }

    // 7. UPDATE VIEWS (Read Receipts)
    match /updateViews/{viewId} {
      allow read: if isDiuUser();
      // Students can only create their own view record
      allow create: if isDiuUser() && request.resource.data.user_id == request.auth.uid;
      // View receipts are immutable audit logs
      allow update, delete: if false;
    }

    // 8. DEVICE TOKENS (FCM)
    match /devices/{deviceId} {
      allow read, write: if isDiuUser() && request.auth.uid == (request.resource.data.user_id || resource.data.user_id);
    }
  }
}
