rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Strict authentication and @diu.edu.bd university domain verification
    function isDiuUser() {
      return request.auth != null &&
             request.auth.token.email_verified == true &&
             request.auth.token.email != null &&
             request.auth.token.email.matches('(?i)^[a-zA-Z0-9._%+-]+@diu[.]edu[.]bd$');
    }

    // Secure administrator verification (Custom claim admin == true or authorized admin email)
    function isAdmin() {
      return request.auth != null && (
        request.auth.token.admin == true ||
        (request.auth.token.email != null && request.auth.token.email.matches('(?i)^madhurzamutsha@gmail[.]com$'))
      );
    }
    
    function isOwner(userId) {
      return (isDiuUser() || isAdmin()) && request.auth.uid == userId;
    }

    function isGroupHost(groupId) {
      return (isDiuUser() || isAdmin()) && 
             exists(/databases/$(database)/documents/groups/$(groupId)) &&
             get(/databases/$(database)/documents/groups/$(groupId)).data.host_id == request.auth.uid;
    }

    function isGroupMember(groupId) {
      return (isDiuUser() || isAdmin()) && 
             (isGroupHost(groupId) || 
              exists(/databases/$(database)/documents/groupMembers/$(groupId + '_' + request.auth.uid)));
    }

    // 1. USERS COLLECTION (Permanent Profiles - Never deleted by 4-month expiration)
    match /users/{userId} {
      allow read: if isDiuUser() || isAdmin();
      // On create: must be verified DIU user matching UID and authenticated email
      allow create: if isOwner(userId) && 
                       request.resource.data.email == request.auth.token.email &&
                       (request.resource.data.role == 'student' || request.resource.data.role == null);
      // On update: user can update own profile (role cannot be arbitrarily set to CR without hosting a group)
      // or group host can clear current_group_id upon group deletion/member removal
      allow update: if (isDiuUser() || isAdmin()) && (
        (isOwner(userId) && 
         request.resource.data.email == resource.data.email &&
         (request.resource.data.role == resource.data.role ||
          request.resource.data.role == 'student' ||
          (request.resource.data.role == 'cr' &&
           request.resource.data.current_group_id != null &&
           isGroupHost(request.resource.data.current_group_id)))) ||
        (resource.data.current_group_id != null &&
         isGroupHost(resource.data.current_group_id) &&
         request.resource.data.current_group_id == null &&
         request.resource.data.email == resource.data.email)
      );
      allow delete: if false; // Permanent identity preservation
    }

    // 2. GROUPS COLLECTION
    match /groups/{groupId} {
      // Readable by all DIU users to allow joining via 6-character code lookup, or by admin
      allow read: if isDiuUser() || isAdmin();
      // Only verified DIU users can create a new group as host
      allow create: if (isDiuUser() || isAdmin()) && 
                       request.resource.data.host_id == request.auth.uid;
      // Strictly only the CR host can update group details or delete the group
      allow update, delete: if (isDiuUser() || isAdmin()) && resource.data.host_id == request.auth.uid;
    }

    // 3. GROUP MEMBERS COLLECTION
    match /groupMembers/{memberId} {
      // Scoped read: member can read their own record or members of the group, or admin
      allow read: if isAdmin() || (isDiuUser() && (
        resource.data.user_id == request.auth.uid ||
        isGroupMember(resource.data.group_id)
      ));
      // Students can add themselves on auto-approval, or CR host can add approved members
      allow create: if (isDiuUser() || isAdmin()) && (
        (request.resource.data.user_id == request.auth.uid && memberId == request.resource.data.group_id + '_' + request.auth.uid) ||
        isGroupHost(request.resource.data.group_id)
      );
      // Students can leave (delete own membership), or CR host can remove members
      allow update, delete: if (isDiuUser() || isAdmin()) && (
        resource.data.user_id == request.auth.uid || 
        isGroupHost(resource.data.group_id)
      );
    }

    // 4. JOIN REQUESTS COLLECTION
    match /joinRequests/{requestId} {
      allow read: if isAdmin() || (isDiuUser() && (
        resource.data.user_id == request.auth.uid || 
        isGroupHost(resource.data.group_id)
      ));
      allow create: if isDiuUser() && 
                       request.resource.data.user_id == request.auth.uid;
      allow update: if isGroupHost(resource.data.group_id);
      allow delete: if (isDiuUser() || isAdmin()) && (
        resource.data.user_id == request.auth.uid || 
        isGroupHost(resource.data.group_id)
      );
    }

    // 5. COURSES COLLECTION
    match /courses/{courseId} {
      // Scoped read: only group members can see courses for their class, or admin
      allow read: if isAdmin() || (isDiuUser() && isGroupMember(resource.data.group_id));
      allow create: if isDiuUser() && isGroupHost(request.resource.data.group_id);
      allow update: if isDiuUser() && isGroupHost(resource.data.group_id);
      allow delete: if isDiuUser() && isGroupHost(resource.data.group_id);
    }

    // 6. ACADEMIC UPDATES COLLECTION (Quiz, Lab, Presentation, Assignment)
    match /updates/{updateId} {
      // Scoped read: only group members can see academic notices for their class, or admin
      allow read: if isAdmin() || (isDiuUser() && isGroupMember(resource.data.group_id));
      // Strictly only the CR host can post, edit, or delete updates
      allow create: if isDiuUser() && isGroupHost(request.resource.data.group_id);
      allow update: if isDiuUser() && isGroupHost(resource.data.group_id);
      allow delete: if isDiuUser() && isGroupHost(resource.data.group_id);
    }

    // 7. UPDATE VIEWS (Read Receipts)
    match /updateViews/{viewId} {
      // View receipts only readable by the student who viewed or the CR host, or admin
      allow read: if isAdmin() || (isDiuUser() && (
        resource.data.user_id == request.auth.uid ||
        isGroupHost(resource.data.group_id)
      ));
      // Students can only create their own view record within their joined group
      allow create: if isDiuUser() && 
                       request.resource.data.user_id == request.auth.uid &&
                       isGroupMember(request.resource.data.group_id);
      allow update: if false;
      allow delete: if (isDiuUser() || isAdmin()) && (
        resource.data.user_id == request.auth.uid ||
        isGroupHost(resource.data.group_id)
      );
    }

    // 8. DEVICE TOKENS (FCM)
    match /devices/{deviceId} {
      allow read: if isDiuUser() && resource.data.user_id == request.auth.uid;
      allow create: if isDiuUser() && request.resource.data.user_id == request.auth.uid;
      allow update: if isDiuUser() && resource.data.user_id == request.auth.uid && request.resource.data.user_id == request.auth.uid;
      allow delete: if isDiuUser() && resource.data.user_id == request.auth.uid;
    }

    // 9. APP CONFIGURATION (Global Operational & Shutdown State)
    match /appConfig/{configId} {
      // Public read so student & CR apps can check availability & maintenance notices
      allow read: if true;
      // Privileged writes only by authorized administrator
      allow write: if isAdmin();
    }

    // 10. ADMIN AUDIT LOGS (Immutable security logs)
    match /adminAuditLogs/{logId} {
      allow read, create: if isAdmin();
      allow update, delete: if false;
    }
  }
}
